# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SERVIDOR APENAS — nunca prefixar com NEXT_PUBLIC_, nunca commitar valor real
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (resend.com) — chave de API e remetente verificado
RESEND_API_KEY=re_...
RESEND_FROM="Plataforma iEsports <plataforma@iesports.com.br>"

# Segredo compartilhado com os workflows do GitHub Actions (cron)
# gere uma string aleatória longa, ex: openssl rand -hex 32
CRON_SECRET=troque-isto

# URL pública da plataforma depois do deploy (usada nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=https://plataforma-iesports.vercel.app
